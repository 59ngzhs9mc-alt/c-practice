{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建当前文件",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.vscode/build.ps1",
        "-Source", "${file}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "构建并运行当前文件",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.vscode/build.ps1",
        "-Source", "${file}",
        "-Run"
      ],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "构建扫雷游戏",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.vscode/build.ps1",
        "-Project", "${workspaceFolder}/practice/mine_sweeping/Project1",
        "-Run"
      ],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "提交并推送到 Gitee + GitHub",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.vscode/push.ps1",
        "-Repo", "${workspaceFolder}",
        "-Message", "${input:commitMsg}"
      ],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "仅推送（不提交）到 Gitee + GitHub",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.vscode/push.ps1",
        "-Repo", "${workspaceFolder}",
        "-PushOnly"
      ],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "commitMsg",
      "type": "promptString",
      "description": "提交说明（直接回车用默认值）",
      "default": "更新练习代码"
    }
  ]
}
