{
  // ---- 编码与换行：保持 VS 的习惯，避免中文注释乱码和整文件 diff ----
  "[c]": {
    "files.encoding": "utf8bom",
    "files.eol": "\r\n"
  },
  "[cpp]": {
    "files.encoding": "utf8bom",
    "files.eol": "\r\n"
  },

  // 隐藏编译中间产物，资源管理器更清爽（这些本来也在 .gitignore 里）
  "files.exclude": {
    "**/.vs": true,
    "**/x64": true,
    "**/Debug": true,
    "**/Release": true,
    "**/build": true,
    "**/*.obj": true,
    "**/*.ipch": true
  },
  "search.exclude": {
    "**/build": true,
    "**/x64": true,
    "**/.vs": true
  },

  // 不要自动删掉行尾空格、不要自动补末尾换行——避免制造无意义的 diff
  "files.trimTrailingWhitespace": false,
  "files.insertFinalNewline": false,

  // C/C++ 智能提示：指向 MinGW 的 gcc，和编译任务保持一致
  "C_Cpp.default.compilerPath": "E:/mingw64/bin/gcc.exe",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.errorSquiggles": "enabled",

  // ---- 打字时不再自动弹补全/参数提示（需要时按 Ctrl+空格 手动呼出）----
  "editor.quickSuggestions":
   {
    "other": false,
    "comments": false,
    "strings": false
  },
  "editor.suggestOnTriggerCharacters": false,
  "editor.wordBasedSuggestions": "off",
  "editor.acceptSuggestionOnEnter": "off",
  "editor.parameterHints.enabled": false,
  "editor.inlineSuggest.enabled": false,

  // 终端默认用 PowerShell，和下面的编译任务一致
  "terminal.integrated.defaultProfile.windows": "Windows PowerShell",

  "git.autofetch": true,
  "git.confirmSync": false
}
