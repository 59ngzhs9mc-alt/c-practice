// 二分查找
#include <stdio.h>

/* 写法 A：闭区间 [left, right]；找到返回下标，找不到返回 -1 */
int binary_search(const int a[], int n, int target)
{
    int left = 0;
    int right = n - 1; /* 闭区间：最后一个元素也算 */

    while (left <= right)
    {                                        /* 区间非空就继续 */
        int mid = left + (right - left) / 2; /* 防溢出写法 */
        if (a[mid] == target)
            return mid;
        else if (a[mid] < target)
            left = mid + 1; /* mid 已比较过，排除掉 */
        else
            right = mid - 1; /* 同上 */
    }
    return -1; /* left > right：区间空了 */
}

/* 写法 B：左闭右开 [left, right)；返回第一个 >= target 的下标，全小于时返回 n */
int lower_bound(const int a[], int n, int target)
{
    int left = 0;
    int right = n; /* 半开区间：right 取 n，不是 n-1 */

    while (left < right)
    {
        int mid = left + (right - left) / 2;
        if (a[mid] < target)
            left = mid + 1;
        else
            right = mid; /* mid 可能是答案，保留在区间里 */
    }
    return left; /* left == right，唯一候选 */
}

int main(void)
{
    int a[] = {1, 3, 5, 7, 9, 11, 13, 15};
    int n = (int)(sizeof(a) / sizeof(a[0]));
    int targets[] = {11, 4, 1, 15, 0, 16};

    printf("== binary_search ==\n");
    for (int i = 0; i < (int)(sizeof(targets) / sizeof(targets[0])); i++)
        printf("找 %2d -> 下标 %d\n", targets[i], binary_search(a, n, targets[i]));

    int b[] = {1, 2, 2, 2, 3, 5}; /* 有重复元素 */
    int m = (int)(sizeof(b) / sizeof(b[0]));
    int qs[] = {1, 2, 3, 4, 6};

    printf("\n== lower_bound（有重复元素）==\n");
    for (int i = 0; i < (int)(sizeof(qs) / sizeof(qs[0])); i++)
        printf("第一个 >= %d 的下标 %d\n", qs[i], lower_bound(b, m, qs[i]));

    return 0;
}